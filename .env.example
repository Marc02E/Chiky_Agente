# Personal AI Secretary — environment configuration reference.
# Copy to `.env` for local runs (or set as real environment variables).
# NEVER commit a real `.env`. Placeholders only here.

# Runtime environment: development | test | production
# In production the service refuses to start with the default development
# JWT_SECRET below (see shared/config.py).
APP_ENV=development

# JWT (all required in production; do not reuse the development default)
# JWT_SECRET=<generate a strong random secret, e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`>
JWT_ISSUER=personal-ai-secretary
JWT_AUDIENCE=personal-ai-secretary-api
# Require a valid Bearer token on every protected endpoint.
JWT_REQUIRED=true

# Database (SQLite dev default; a managed database is reserved infrastructure)
# DATABASE_URL=sqlite+aiosqlite:///./personal_ai_secretary.db
# Connection pool settings (FASE 14B)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# AI provider mode: deterministic | local | remote
# `remote` selects the NVIDIA provider (FASE 13C). In production,
# AI_PROVIDER=remote requires NVIDIA_API_KEY to be set (see shared/config.py).
AI_PROVIDER=deterministic
# Ollama local provider options
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# NVIDIA remote provider options (AI_PROVIDER=remote)
# NVIDIA_API_KEY=<NVIDIA API key; never commit a real key>
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# Provider HTTP timeout in seconds
# PROVIDER_TIMEOUT_SECONDS=30.0

# FASE 13A compliance governance
# COMPLIANCE_ENABLED=true
# COMPLIANCE_RULES=prohibited_commands,credential_leakage
# FASE 13B persistent RAG (persistent_stores) — optional source TTL in seconds
# EVIDENCE_TTL_SECONDS=
# Enable PostgreSQL-backed stores (FASE 14A)
# PERSISTENT_STORES=false
# Audit retention in seconds (default 30 days)
# AUDIT_RETENTION_SECONDS=2592000
# Background sweep interval in seconds
# CLEANUP_INTERVAL_SECONDS=3600
# Stale-running recovery threshold in seconds
# STALE_RUNNING_SECONDS=300

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Observability
# OpenTelemetry tracing (FASE 12A/12B/12C/12D/12E/12F/12G): spans are always
# captured in-process. When OTEL_EXPORTER_ENDPOINT points to an OTLP/HTTP
# collector (e.g. a local OpenTelemetry Collector), completed spans are
# exported to it; otherwise they are retained in an in-memory buffer and no
# network is used. Since 12B every HTTP request is rooted in an `http.request`
# span and since 12C audit events and duration gauges carry `trace_id`/
# `span_id`. Since 12F an inbound W3C `traceparent` header (when valid) makes
# the request span a child of the caller's distributed trace, and outbound
# provider calls propagate the current trace. Metrics aggregation is DB-backed
# (metric_records table). Only non-sensitive attributes (method, route
# template, status code, request/session/correlation ids, trace/span ids,
# user id, risk level, stage, outcome, provider and tool names) are recorded;
# never secrets or prompts.
# OTEL_ENABLED=true
# OTEL_EXPORTER_ENDPOINT=http://127.0.0.1:4318
#
# FASE 12D OTLP export hardening. The exporter timeout is in seconds.
# OTEL_EXPORT_HEADERS accepts a JSON object of static headers for
# external/cloud collectors (e.g. {"Authorization":"..."}); it is read from
# the environment, never logged and never placed on spans. Compression is
# "gzip" or "none". The batch knobs bound export cost.
# OTEL_EXPORT_TIMEOUT_SECONDS=10.0
# OTEL_EXPORT_HEADERS={"Authorization":"..."}
# OTEL_EXPORT_COMPRESSION=gzip
# OTEL_EXPORT_BATCH_SCHEDULE_SECONDS=5.0
# OTEL_EXPORT_BATCH_MAX_QUEUE_SIZE=2048
# OTEL_EXPORT_BATCH_MAX_EXPORT_BATCH_SIZE=512
#
# FASE 12E tracing governance. Sampling ratio is parent-based: 1.0 traces
# every span (current default), 0.0 disables sampling, in-between samples by
# trace id. OTEL_WORKER_ID attributes spans to a worker/replica and is
# auto-generated per process when unset. OTEL_SERVICE_VERSION sets the
# service.version resource attribute.
# OTEL_SAMPLING_RATIO=1.0
# OTEL_WORKER_ID=
# OTEL_SERVICE_VERSION=1.0.0